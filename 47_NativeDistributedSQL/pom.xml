<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>io.forest.cdm</groupId>
    <artifactId>cdm-platform-poc</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>cdm-platform-poc</name>
    <description>
        Customer Data Management (CDM) PoC: a modular monolith on a Native Distributed SQL
        database, used to compare region-local (Pattern A) with cross-region (Pattern B)
        ACID transactions and to prove there is no need for Saga/TCC/Outbox compensation.
    </description>

    <properties>
        <java.version>21</java.version>
        <spring-modulith.version>1.4.13</spring-modulith.version>
        <!--
            Spring Boot 3.5 manages JUnit 5.12 (Platform 1.12). The Cucumber engine needs
            org.junit.platform.engine.support.discovery.DiscoveryIssueReporter, which only exists
            from Platform 1.13, so the BOM is bumped to 5.13.x.
        -->
        <junit-jupiter.version>5.13.4</junit-jupiter.version>
        <cucumber.version>7.34.8</cucumber.version>
        <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
        <!-- Pinned explicitly: Spring Boot manages the plugin but exposes no version property. -->
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- CockroachDB / YugabyteDB speak the PostgreSQL wire protocol; no vendor driver required. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Modular monolith: module boundaries are enforced at build time, not by network hops. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>

        <!--
            Migration PoC: the legacy document store. The raw synchronous driver is used rather
            than Spring Data MongoDB so the module boundary stays explicit and no auto-configured
            Mongo template leaks into the other modules.
        -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- End-to-end test stack. No mocks: real HTTP against a real cluster. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-spring</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            No Testcontainers: the suite drives the docker compose CLI directly, which avoids the
            legacy docker-compose binary requirement and the side-car reaper container.
        -->
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>${cucumber.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Default `mvn test` runs unit + architecture tests only: no Docker required. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Opt-in end-to-end profile. Requires a running Docker daemon: it boots a real
            two-region CockroachDB cluster through Testcontainers, runs the application against
            it and exercises it over real HTTP. Nothing is mocked.

                mvn verify -Pe2e

            Artefacts produced:
                target/cucumber-reports/cucumber.html   readable end-to-end report
                target/site/jacoco/                     code coverage
                target/poc-reports/                     one report per proof of concept
        -->
        <profile>
            <id>e2e</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*Test.java</include>
                                <include>**/*Tests.java</include>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                    </plugin>

                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco.version}</version>
                        <executions>
                            <execution>
                                <id>check-coverage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <!-- Reports the number without failing the build; flip
                                         haltOnFailure to true once the baseline is agreed. -->
                                    <haltOnFailure>false</haltOnFailure>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.80</minimum>
                                                </limit>
                                                <limit>
                                                    <counter>BRANCH</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.70</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- One report per proof of concept, from Cucumber JSON + JaCoCo CSV. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>poc-coverage-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>python3</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/generate_poc_report.py</argument>
                                        <argument>--cucumber-json</argument>
                                        <argument>${project.build.directory}/cucumber-reports/cucumber.json</argument>
                                        <argument>--jacoco-csv</argument>
                                        <argument>${project.build.directory}/site/jacoco/jacoco.csv</argument>
                                        <argument>--out-dir</argument>
                                        <argument>${project.build.directory}/poc-reports</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
