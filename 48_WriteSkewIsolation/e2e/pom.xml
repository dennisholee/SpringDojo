<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.forest.isolation</groupId>
        <artifactId>write-skew-poc</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>e2e</artifactId>
    <packaging>jar</packaging>
    <name>e2e</name>
    <description>
        End-to-end Cucumber suite. Boots real MongoDB and CockroachDB containers, drives the shared
        invariant through both adapters and reports the verdict. No mocks, no in-memory database.
    </description>

    <dependencies>
        <dependency>
            <groupId>io.forest.isolation</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.forest.isolation</groupId>
            <artifactId>adapter-mongo</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.forest.isolation</groupId>
            <artifactId>adapter-cockroach</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-picocontainer</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
        </dependency>
        <!--
            Declared explicitly so surefire runs the launcher matching the platform jars on the
            test classpath instead of resolving one of its own (which may be a newer release).
        -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            Opt-in end-to-end profile. Requires a running Docker daemon: it boots both Compose
            files, waits for readiness, runs the scenarios against the real engines and tears down.

                mvn -pl e2e -am -Pe2e test

            Without the profile, `*IT` is not matched by surefire, so a plain `mvn test` never
            touches Docker.
        -->
        <profile>
            <id>e2e</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
